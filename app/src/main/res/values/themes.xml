<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ComponentActivity + Compose: only needs a basic window style -->
    <style name="Theme.ITFlowMSP" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Cold-start splash — shown until installSplashScreen()'s keepOnScreenCondition clears. -->
    <style name="Theme.ITFlowMSP.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D6EFD</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ITFlowMSP</item>
    </style>
</resources>
